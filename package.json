{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix app components layouts scripts",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck:flow-board": "tsc --noEmit -p tsconfig.strict.json"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "12.12.1",
    "body-scroll-lock": "^3.1.5",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.1.0",
    "next": "16.4.5",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "yarn eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "yarn prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1",
  "resolutions": {
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/propagator-jaeger": "2.12.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "cacache/glob": "14.0.2",
    "js-yaml": "4.3.2",
    "katex": "0.18.2",
    "minimatch": "11.0.1",
    "postcss-selector-parser": "6.1.5",
    "toml": "5.0.1",
    "uuid": "11.1.1",
    "zod": "4.6.7",
    "@contentlayer2/utils@0.5.8": "patch:@contentlayer2/utils@npm%3A0.5.8#./.yarn/patches/@contentlayer2-utils-npm-0.5.8-f14c371a28.patch",
    "@eslint/eslintrc@^3.3.7": "patch:@eslint/eslintrc@npm%3A3.3.7#./.yarn/patches/@eslint-eslintrc-npm-3.3.7-53b0368519.patch",
    "gray-matter@^4.0.3": "patch:gray-matter@npm%3A4.0.3#./.yarn/patches/gray-matter-npm-4.0.3-852ae4f34c.patch"
  }
}
